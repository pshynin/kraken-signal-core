# ── Required ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Discord webhooks (optional — omit to disable alerts) ───────────────────────
# Create separate channels or use the same URL for all three.
DISCORD_WEBHOOK_CLEAN=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_UGLY=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_SYSTEM=https://discord.com/api/webhooks/...

# ── Runtime controls (optional) ────────────────────────────────────────────────
SCANNER_ENV=production          # development | production
SCANNER_TRIGGERED_BY=manual     # schedule | manual | ci
SCANNER_VERSION=local           # populated automatically in GitHub Actions

# ── numba / pandas_ta (set by docker-compose, override only if needed) ──────────
# The scanner does not use numba JIT. Disabling it avoids a pandas_ta import-time
# crash in Docker ("cannot cache function 'fibonacci': no locator available").
# These are already set on the compose `scanner` service — listed here for
# reference. Set them when running outside compose (e.g. a bare `python -m`).
NUMBA_DISABLE_JIT=1
NUMBA_CACHE_DIR=/tmp/numba_cache
