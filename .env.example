# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Used by: scanner (server-only), web server components (server-only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used by: web app (safe for browser — anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Discord Webhooks ──────────────────────────────────────────────────────────
# NEVER expose these to the frontend. Scanner-only secrets.
# Create webhooks: Discord channel settings → Integrations → Webhooks

DISCORD_WEBHOOK_CLEAN=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_UGLY=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_SYSTEM=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Dashboard auth ────────────────────────────────────────────────────────────
# Simple passcode gate for the Next.js dashboard.
# Change this before deploying. Use a long random string.
DASHBOARD_PASSCODE=change-me-before-deploying

# ── Scanner runtime ───────────────────────────────────────────────────────────
# Set to "production" in GitHub Actions / Vercel prod environment.
SCANNER_ENV=development
