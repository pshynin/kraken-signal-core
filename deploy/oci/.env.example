# OCI VM scanner runtime environment.
#
# Copy to /opt/momentum-copilot/.env on the VM and fill in real values.
# This file lives ONLY on the VM — the Supabase service-role key must never be
# stored in GitHub Actions secrets. The root docker-compose.yml reads this via
# `env_file: .env`.
#
#   cp deploy/oci/.env.example /opt/momentum-copilot/.env
#   chmod 600 /opt/momentum-copilot/.env
#   nano /opt/momentum-copilot/.env

# ── Required ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Discord webhooks (optional — omit to disable alerts) ───────────────────────
DISCORD_WEBHOOK_CLEAN=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_UGLY=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_SYSTEM=https://discord.com/api/webhooks/...

# ── Runtime controls ───────────────────────────────────────────────────────────
SCANNER_ENV=production
SCANNER_TRIGGERED_BY=schedule
SCANNER_VERSION=oci

# ── numba / pandas_ta ──────────────────────────────────────────────────────────
# The root docker-compose.yml already sets these on the scanner service, so you
# normally do NOT need them here. The scanner does not use numba JIT; disabling
# it avoids a pandas_ta import-time crash in the OCI Docker runtime
# ("RuntimeError: cannot cache function 'fibonacci': no locator available").
# NUMBA_DISABLE_JIT=1
# NUMBA_CACHE_DIR=/tmp/numba_cache
