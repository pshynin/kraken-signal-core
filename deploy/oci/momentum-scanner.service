# momentum-scanner.service — runs one scan, then exits.
#
# Triggered by momentum-scanner.timer (every 6h). Not enabled directly; the
# timer starts it. systemd will not start a second instance while one is still
# active, which (together with the flock in momentum-scanner.sh) guarantees no
# overlapping scanner runs.
#
# Install:
#   sudo cp deploy/oci/momentum-scanner.service /etc/systemd/system/
#   sudo cp deploy/oci/momentum-scanner.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now momentum-scanner.timer
#
# Logs:        journalctl -u momentum-scanner.service
# Run now:     sudo systemctl start momentum-scanner.service

[Unit]
Description=Momentum scanner — one scan run
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot

# Adjust User to the VM's deploy user (e.g. ubuntu on Canonical, opc on Oracle
# Linux). The user must be in the `docker` group.
User=ubuntu
WorkingDirectory=/opt/momentum-copilot

# Kill a hung scan rather than letting it block the next tick (mirrors the old
# GitHub Actions timeout-minutes: 30).
RuntimeMaxSec=1800

# The runner adds its own flock guard and tees to /var/log/momentum-scanner.log.
ExecStart=/opt/momentum-copilot/deploy/oci/momentum-scanner.sh

[Install]
WantedBy=multi-user.target
